# ============================================================
# Incident Response Simulator - .gitignore
# ============================================================

# --- App-generated runtime data (created by incident_response.py) ---
leaderboard.json
metrics_history.json
project_info.json

# --- Secrets / environment (ANTHROPIC_API_KEY etc.) ---
.env
.env.*
!.env.example
*.key
*.pem

# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual environments ---
venv/
.venv/
env/
ENV/

# --- Packaging / build artifacts ---
build/
dist/
*.egg-info/
*.spec
pip-wheel-metadata/

# --- Logs ---
*.log

# --- Exported charts / reports (matplotlib exports) ---
*.png
*.pdf
!docs/**/*.png

# --- IDE / editor ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini
